# copy to .dev.vars — users as name:password[:admin|:author] (no role = rater)
# production: wrangler secret put USERS --env commons
# local only, never set in production: log in with just a name
ALLOW_EMPTY_PASSWORDS=true
USERS=admin::admin,author::author,rater,guest
# Stripe: connect a test key on /admin; webhooks locally via `stripe listen --forward-to localhost:5173/api/stripe/webhook`,
# whose signing secret goes here
STRIPE_WEBHOOK_SECRET=
